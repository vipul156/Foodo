# ai-dispatch — Autonomous Dispatch Swarm
PORT=3010
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

INTERNAL_SERVICE_KEY=your-internal-service-key

MONGO_URI=mongodb://localhost:27017/foodo
# REDIS_URL=redis://localhost:6379/0   # optional: multi-pod idempotency

# Sibling services
RESTAURANT_SERVICE_URL=http://localhost:3003
RIDER_SERVICE_URL=http://localhost:3004
REALTIME_SERVICE_URL=http://localhost:3002

# Messaging
RABBITMQ_URL=amqp://localhost
ORDER_EXCHANGE=order.events           # fanout the swarm consumes
DISPATCH_EXCHANGE=dispatch.events     # fanout the swarm publishes
DISPATCH_QUEUE=dispatch.orders
ORDER_QUEUE_NAME=order:ready_for_rider

# LLM (optional — kitchen refinement only, bounded ±40%)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Dispatch bounds
RIDER_SEARCH_RADIUS_KM=10
BATCH_RADIUS_M=500
BATCH_DROP_RADIUS_M=2000
BATCH_SLA_PENALTY_S=300
PREP_BASE_MINUTES=18
PREP_MIN_MINUTES=10
PREP_MAX_MINUTES=45
SURGE_SMALL=10
SURGE_LARGE=25
MAX_GRAPH_STEPS=24
