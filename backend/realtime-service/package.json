{
  "name": "@foodo/realtime-service",
  "version": "1.0.0",
  "description": "Foodo realtime service (long-running socket.io; events fan in from SNS via SQS).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@foodo/backend-common": "workspace:*",
    "@foodo/types": "workspace:*",
    "@aws-sdk/client-sqs": "catalog:",
    "@socket.io/redis-adapter": "catalog:",
    "cookie-session": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "^4.21.0",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "serverless-http": "catalog:",
    "socket.io": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/cookie-session": "catalog:",
    "@types/dotenv": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
