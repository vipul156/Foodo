# @foodo/ai-commerce — conversational ordering agent (deploy-time env)
# HTTP-only FastAPI Lambda behind the shared JWT authorizer. Sibling
# URLs, the commerce-sessions table, the shared rate-limit counter table
# and the SNS topic are injected by serverless.yml from the
# foodo-core-api / foodo-infra exports — only the values below are set
# by hand. Settings validate at import time and refuse to boot without
# JWT_SECRET, COOKIE_SECRET and INTERNAL_SERVICE_KEY.

# Identity plane — MUST match JWT_SECRET / COOKIE_SECRET in core/ and the
# sibling services: the central authorizer verifies these tokens.
JWT_SECRET=change-me-32-bytes-of-random-hex
COOKIE_SECRET=change-me-32-bytes-of-random-hex

# Shared secret for service-to-service calls (x-internal-key) — required.
INTERNAL_SERVICE_KEY=change-me-32-bytes-of-random-hex

# ─── Reasoning model (turns can chain several LLM calls) ─────────────
# Optional: without a key the agent's tool-choice degrades to the
# deterministic heuristic path.
# Any OpenAI-compatible vendor: set LLM_PROVIDER + LLM_MODEL + LLM_API_KEY.
# Built-in endpoints: groq, openai, openrouter, together, fireworks,
# deepseek, ollama, lmstudio. Anything else needs LLM_BASE_URL
# (vLLM, TGI, a self-hosted gateway). Groq example:
#   LLM_PROVIDER=groq
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=

# ─── Logging (forwarded to the app as LOG_LEVEL) ────────────────────
COMMERCE_LOG_LEVEL=INFO

# ─── Advanced: code defaults (NOT forwarded by serverless.yml) ───────
# Add the variable to this stack's `environment:` block to override it.
# LLM_TIMEOUT_S=30
# LLM_MAX_TOKENS=1024
# SESSION_TTL_MIN=60               # DynamoDB TTL on draft sessions
# SESSION_MAX_TURNS=30
# HISTORY_WINDOW=12                # messages fed back to the model
# MAX_UNITS_PER_ITEM=20
# MAX_CART_VALUE=10000             # absolute clamp on draft totals
# MAX_MENU_CANDIDATES=5
# SEMANTIC_MATCH_THRESHOLD=0.35
# MAX_GRAPH_STEPS=40
# RATE_LIMIT_TURNS=15              # per user, per minute

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
