# ai-commerce — Conversational Commerce & Ordering Agent
PORT=3009
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Secrets — JWT/COOKIE must mirror the auth service's values (same identity plane)
JWT_SECRET=your-jwt-secret
COOKIE_SECRET=your-cookie-secret
INTERNAL_SERVICE_KEY=your-internal-service-key

# Data stores
MONGO_URI=mongodb://localhost:27017/foodo
# REDIS_URL=redis://localhost:6379/0   # optional: multi-pod rate limiting

# Sibling services
AUTH_SERVICE_URL=http://localhost:3001
RESTAURANT_SERVICE_URL=http://localhost:3003
UTILS_SERVICE_URL=http://localhost:3005

# LLM (LangChain provider)
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=1024

# Events
RABBITMQ_URL=amqp://localhost
COMMERCE_EXCHANGE=commerce.events

# Guardrails
SESSION_TTL_MIN=60
SESSION_MAX_TURNS=30
RATE_LIMIT_TURNS=15
MAX_GRAPH_STEPS=40
SEMANTIC_MATCH_THRESHOLD=0.35
