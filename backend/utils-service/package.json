{
  "name": "@foodo/utils-service",
  "version": "1.0.0",
  "description": "Foodo utils service (payments, uploads).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --target node20 --platform node --shims --clean --minify --no-splitting",
    "start": "node dist/index.cjs",
    "dev": "tsx --watch src/index.ts"
  },
  "dependencies": {
    "@foodo/backend-common": "workspace:*",
    "@foodo/types": "workspace:*",
    "amqplib": "^2.0.1",
    "axios": "^1.18.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "opossum": "^5.0.1",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.6",
    "serverless-http": "^4.0.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/cors": "catalog:",
    "@types/dotenv": "^6.1.1",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/opossum": "^8.1.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
