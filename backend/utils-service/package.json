{
  "name": "@foodo/utils-service",
  "version": "1.0.0",
  "description": "Foodo utils service (payments, uploads).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format cjs --target node20 --platform node --shims --clean --minify --no-splitting",
    "start": "node dist/index.cjs",
    "dev": "tsx --watch src/index.ts",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@foodo/backend-common": "workspace:*",
    "@foodo/types": "workspace:*",
    "amqplib": "catalog:",
    "axios": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "multer": "catalog:",
    "opossum": "catalog:",
    "rate-limit-redis": "catalog:",
    "razorpay": "catalog:",
    "serverless-http": "catalog:",
    "stripe": "catalog:"
  },
  "devDependencies": {
    "@types/amqplib": "catalog:",
    "@types/dotenv": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/opossum": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
