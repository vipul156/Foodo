# @foodo/ai-menu-parser — menu photo digitization (deploy-time env)
# Seller surface: the shared JWT authorizer (cookie session) gates the
# gateway, require_user re-verifies in-app, and bulk publish forwards the
# seller session to restaurant-service. Sibling URL, the rate-limit
# counter table and the authorizer id are injected by serverless.yml from
# the foodo-core-api / foodo-infra exports — only the values below are
# set by hand.

# Identity plane — MUST match JWT_SECRET / COOKIE_SECRET in core/ and the
# sibling services: the in-app session verifier rejects every call
# otherwise.
JWT_SECRET=change-me-32-bytes-of-random-hex
COOKIE_SECRET=change-me-32-bytes-of-random-hex

# Shared secret for service-to-service calls (x-internal-key) — required.
INTERNAL_SERVICE_KEY=change-me-32-bytes-of-random-hex

# ─── Vision provider (required — the parser fails closed without it) ─
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Logging (forwarded to the app as LOG_LEVEL) ────────────────────
MENU_PARSER_LOG_LEVEL=INFO

# ─── Advanced: code defaults (NOT forwarded by serverless.yml) ───────
# Add the variable to this stack's `environment:` block to override it.
# GEMINI_TIMEOUT_S=45              # structured-vision calls are slow
# GEMINI_MAX_OUTPUT_TOKENS=8192
# MAX_CATEGORIES=20
# MAX_ITEMS_PER_CATEGORY=40
# MAX_MENU_ITEMS=150
# MAX_PRICE=100000
# MAX_IMAGE_BYTES=10485760         # 10 MB parse input cap
# MAX_BULK_ITEMS=300               # per bulk-publish call
# BREAKER_RESET_TIMEOUT_S=30
# RATE_LIMIT_PARSE_PER_MIN=5       # per seller — vision calls cost money

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
