# @foodo/ai-dispatch — dispatch swarm (deploy-time env)
# Event-driven: the foodo-events SNS topic feeds this stack's own
# dispatch-orders queue (filtered to order:ready_for_rider), and
# dispatchConsumer runs the graph. The HTTP surface is ops-only
# (snapshot / simulate / health). Table names, sibling URLs and the
# topic ARN are injected by serverless.yml from the foodo-infra /
# foodo-core-api exports — only the values below are set by hand.
# Settings validate at import time and refuse to boot without
# INTERNAL_SERVICE_KEY.

# Shared secret for service-to-service calls (x-internal-key) — required.
# Validated at import, so an empty value deploys a stack that 500s on every
# route; serverless.yml therefore has no fallback and the deploy aborts
# when it is unset. Must be the exact value the whole platform uses
# (admin-service sends it, this stack answers it).
INTERNAL_SERVICE_KEY=change-me-32-bytes-of-random-hex

# ─── Reasoning model (bounded nodes only; kitchen refinement) ────────
# Optional: without a key the swarm runs heuristic-only.
# Any OpenAI-compatible vendor: set LLM_PROVIDER + LLM_MODEL + LLM_API_KEY.
# Built-in endpoints: groq, openai, openrouter, together, fireworks,
# deepseek, ollama, lmstudio. Anything else needs LLM_BASE_URL
# (vLLM, TGI, a self-hosted gateway). Groq example:
#   LLM_PROVIDER=groq
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=

# ─── Logging (forwarded to the app as LOG_LEVEL) ────────────────────
DISPATCH_LOG_LEVEL=INFO

# ─── Advanced: code defaults (NOT forwarded by serverless.yml) ───────
# Add the variable to this stack's `environment:` block to override it.
# LLM_TIMEOUT_S=20
# LLM_MAX_TOKENS=600
# RIDER_SEARCH_RADIUS_KM=10
# BATCH_RADIUS_M=500               # pickup co-location threshold
# BATCH_DROP_RADIUS_M=2000         # drop co-location threshold
# BATCH_SLA_PENALTY_S=300          # max SLA delay batching may impose
# MAX_CANDIDATES=12                # rider shortlist size
# PREP_BASE_MINUTES=18
# PREP_PER_ITEM_MINUTES=1.2
# PREP_COMPLEXITY_MINUTES=6
# PREP_QUEUE_MINUTES=2
# PREP_MIN_MINUTES=10
# PREP_MAX_MINUTES=45
# SURGE_SMALL=10
# SURGE_LARGE=25
# SURGE_COOLOFF_MIN=10
# INTERNAL_TIMEOUT_S=4
# WEATHER_TIMEOUT_S=6
# MAX_GRAPH_STEPS=24
# IDEMPOTENCY_TTL_S=300            # ready-event claim lifetime
# POOL_TTL_S=7200                  # broadcast pool row lifetime

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
