# @foodo/ai-verification — visual verification stack (deploy-time env)
# Packing checks + proof of delivery. Table names, the shared HTTP API
# and the SNS topic are injected by serverless.yml from the
# foodo-infra / foodo-core-api exports — only the values below are set
# by hand. Every AI failure degrades to "unverified"; the service never
# 5xx on a dead provider.

# Shared secret for service-to-service calls (x-internal-key). Callers
# are restaurant-service (packing) and rider-service (delivery). The
# middleware fails closed, so an empty value rejects every request.
INTERNAL_SERVICE_KEY=change-me-32-bytes-of-random-hex

# ─── Vision model (OpenAI-compatible; unconfigured = unverified) ─────
# One model behind every vendor: it must accept image_url content parts
# and response_format=json_object. Presets with a built-in endpoint:
# openai, groq, openrouter, together, fireworks, deepseek, ollama,
# lmstudio. Any other value needs LLM_BASE_URL.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# Only for providers outside the preset list (vLLM, LiteLLM, a proxy...).
LLM_BASE_URL=

# ─── Evidence storage (the photo outlives the verdict) ───────────────
# Read by the cloudinary SDK: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Unset = verdicts still persist, but every row carries image.url = null.
CLOUDINARY_URL=
# Root asset namespace for this stack (verification/ evidence lives under it)
CLOUDINARY_FOLDER=foodo

# Browser origin allowed by CORS (no browser calls here; devtools only).
FRONTEND_URL=http://localhost:3000

# ─── Advanced: code defaults (NOT forwarded by serverless.yml) ───────
# Add the variable to this stack's `environment:` block to override it.
# AI_TIMEOUT_MS=12000              # per-model call budget
# AI_MAX_IMAGE_BYTES=5242880       # inbound photo cap (5 MB)
# VERIFICATION_TTL_DAYS=90         # evidence retention on the verdict row

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
