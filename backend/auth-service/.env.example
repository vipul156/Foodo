# @foodo/auth-service — token issuer (deploy-time env)
# MUST match core/.env JWT_SECRET and sibling services.
JWT_SECRET=change-me-32-bytes-of-random-hex
COOKIE_SECRET=change-me-32-bytes-of-random-hex
REFRESH_COOKIE_NAME=refresh_token

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
