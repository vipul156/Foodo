{
  "name": "@foodo/auth-service",
  "version": "1.0.0",
  "description": "Foodo authentication service (HTTP + internal worker handlers).",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/handlers/publicHttp.ts src/handlers/internalWorker.ts --format esm --target node20 --clean --minify --no-splitting",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@foodo/backend-common": "workspace:*",
    "@foodo/types": "workspace:*",
    "axios": "catalog:",
    "bcrypt": "catalog:",
    "cookie-parser": "catalog:",
    "cookie-session": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "express-rate-limit": "catalog:",
    "googleapis": "catalog:",
    "jsonwebtoken": "catalog:",
    "mongoose": "catalog:",
    "serverless-http": "catalog:"
  },
  "devDependencies": {
    "@types/bcrypt": "catalog:",
    "@types/cookie-parser": "catalog:",
    "@types/cors": "catalog:",
    "@types/cookie-session": "catalog:",
    "@types/dotenv": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
