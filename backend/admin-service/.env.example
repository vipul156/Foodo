# @foodo/admin-service (deploy-time env)
JWT_SECRET=change-me-32-bytes-of-random-hex
COOKIE_SECRET=change-me-32-bytes-of-random-hex

# Shared secret for service-to-service calls (x-internal-key). The dispatch
# snapshot lives in ai-dispatch behind this gate. REQUIRED at deploy: with
# no value the stack refuses to build, because it would only produce a 503
# here and a 403 at the swarm. Every stack must resolve the SAME value —
# export it once in the deploying shell (serverless' dotenv never overrides
# an existing process variable, so a stale service-local .env cannot win).
INTERNAL_SERVICE_KEY=change-me-32-bytes-of-random-hex

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
