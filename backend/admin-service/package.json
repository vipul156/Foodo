{
  "name": "@foodo/admin-service",
  "version": "1.0.0",
  "description": "Foodo admin API service.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean --minify --no-splitting",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "catalog:",
    "@foodo/backend-common": "workspace:*",
    "@foodo/types": "workspace:*",
    "axios": "catalog:",
    "cookie-session": "catalog:",
    "cors": "catalog:",
    "dotenv": "catalog:",
    "express": "catalog:",
    "jsonwebtoken": "catalog:",
    "serverless-http": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-session": "catalog:",
    "@types/dotenv": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
