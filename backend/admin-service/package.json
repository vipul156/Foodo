{
  "name": "@foodo/admin-service",
  "version": "1.0.0",
  "description": "Foodo admin API service.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --clean --minify --no-splitting",
    "start": "node dist/index.js",
    "dev": "tsx --watch src/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1141.0",
    "@foodo/backend-common": "workspace:*",
    "@foodo/types": "workspace:*",
    "axios": "^1.18.1",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "catalog:",
    "@types/dotenv": "^6.1.1",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
