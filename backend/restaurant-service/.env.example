# @foodo/restaurant-service (deploy-time env)
JWT_SECRET=change-me-32-bytes-of-random-hex
COOKIE_SECRET=change-me-32-bytes-of-random-hex
# Shared secret for service-to-service calls (x-internal-key header).
# Required at deploy (no fallback) and must be the same value everywhere —
# this stack validates the payment-claim gate with it and calls the AI tier.
INTERNAL_SERVICE_KEY=change-me-32-bytes-of-random-hex
# cloudinary://<api_key>:<api_secret>@<cloud_name> — signed direct uploads
CLOUDINARY_URL=
# Root asset namespace for this stack (menu-items/, restaurants/ live under it)
CLOUDINARY_FOLDER=foodo

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
