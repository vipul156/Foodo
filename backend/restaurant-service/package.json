{
  "name": "@foodo/restaurant-service",
  "version": "1.0.0",
  "description": "Foodo restaurant/menu/order service (serverless Lambda — API Gateway HTTP + SQS consumers).",
  "private": true,
  "type": "module",
  "scripts": {
