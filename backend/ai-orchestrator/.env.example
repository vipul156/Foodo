# @foodo/ai-orchestrator — refund arbitration agent (deploy-time env)
# Two doors, one graph: HTTP dispute intake (POST /api/agent/dispute)
# stores the evidence and enqueues a work item, disputeConsumer runs the
# graph off the agent-disputes queue. Table names, the shared HTTP API
# (utils / restaurant / rider), the SNS topic and the queue URL are
# injected by serverless.yml — only the values below are set by hand.

# Shared secret for service-to-service calls (x-internal-key). Gates the
# review-queue read and tags every outbound internal call. Required: the
# settings refuse to boot without it, so serverless.yml has no fallback and
# the deploy aborts when it is unset. Must be the exact value the rest of
# the platform uses.
INTERNAL_SERVICE_KEY=change-me-32-bytes-of-random-hex

# ─── Reasoning model (complaint parse, photo triage, summaries) ──────
# Any OpenAI-compatible endpoint: the provider preset picks the base URL
# (openai, groq, openrouter, together, fireworks, deepseek, ollama,
# lmstudio), anything else needs LLM_BASE_URL. The model must accept
# image_url content parts and response_format=json_object. Optional:
# unconfigured, every LLM node returns null and the graph falls back to
# its deterministic rules.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

# ─── Dispute evidence (server-side Cloudinary upload) ────────────────
# Either the URL shorthand OR the three separate names — the shared
# uploader accepts both. Intake 503s when credentials are missing: with
# no stored copy the case would escalate on "no photo evidence".
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root asset namespace for this stack (disputes/evidence lives under it)
CLOUDINARY_FOLDER=foodo

# Browser origin allowed by CORS (disputes are proxied by the platform API).
FRONTEND_URL=http://localhost:3000

# ─── Advanced: code defaults (NOT forwarded by serverless.yml) ───────
# Add the variable to this stack's `environment:` block to override it.
# AGENT_MAX_AUTO_REFUND=500        # ₹ ceiling for an auto-refund
# AGENT_VOUCHER_CAP=150            # ₹ ceiling for a goodwill voucher
# LLM_TIMEOUT_MS=30000
# INTERNAL_HTTP_TIMEOUT_MS=5000
# EVIDENCE_DOWNLOAD_TIMEOUT_MS=10000

# Optional: org permissions boundary for this service's Lambda role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
