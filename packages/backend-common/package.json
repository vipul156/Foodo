{
  "name": "@foodo/backend-common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Node-only backend utilities (middleware, DB connection helpers). Never import from browser code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@foodo/types": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
