{
  "name": "@foodo/backend-common",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Node-only backend utilities (auth middleware, guards, upload, internal-key check, shared mongoose schemas). Never import from browser code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@foodo/types": "workspace:*"
  },
  "peerDependencies": {
    "bcrypt": "^6.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^9.0.0",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "bcrypt": "catalog:",
    "mongoose": "catalog:",
    "typescript": "catalog:"
  }
}
