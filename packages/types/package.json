{
  "name": "@foodo/types",
  "version": "0.1.0",
  "private": true,
  "description": "Universal TypeScript interfaces, DTOs, and enums shared by Foodo apps and services (0 runtime dependencies).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
