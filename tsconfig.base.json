{
  // Shared compiler options for every package in the monorepo.
  // Environment-specific settings (module/target/libs, DOM vs Node) stay in
  // each package's own tsconfig.json, which extends this file.
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  }
}
