    auth.vm.provider "virtualbox" do |vb|
      vb.memory = "300"
    end
    auth.vm.synced_folder "./env/auth",
                            "/etc/foodo",
                            type: "virtualbox"
    auth.vm.provision "shell", path: "auth.sh"
  end

