# foodo-core-api — core compute stack (deploy-time env)
# MUST match JWT_SECRET across all backend/* services: the central
# authorizer verifies the access tokens auth-service mints.
JWT_SECRET=change-me-32-bytes-of-random-hex
FRONTEND_URL=http://localhost:3000

# Optional: org permissions boundary for the authorizer function role.
# IAM_PERMISSIONS_BOUNDARY_ARN=arn:aws:iam::123456789012:policy/MyBoundary
