{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The shared base enables two extra-strict flags that the backend
    // services use. This app predates them and its code relies on the
    // looser behavior, so opt out to keep typechecking identical to the
    // pre-monorepo setup. Adopt deliberately, with code changes.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "sst.config.ts", ".sst"]
}
