# ai-menu-parser — Multimodal Menu Digitization
PORT=3011
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000

# Secrets (same identity plane as the Node services)
JWT_SECRET=must-match-auth-service
COOKIE_SECRET=must-match-auth-service
INTERNAL_SERVICE_KEY=your-internal-service-key

# Sibling services
RESTAURANT_SERVICE_URL=http://localhost:3003

# Vision provider (structured JSON mode)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=45

# Bounds
RATE_LIMIT_PARSE_PER_MIN=5
MAX_MENU_ITEMS=150
MAX_BULK_ITEMS=300
