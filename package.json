{
  "name": "foodo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,json,md,yml,yaml}\"",
    "deploy:infra": "turbo run deploy --filter=@foodo/infra",
    "deploy:core": "turbo run deploy --filter=@foodo/core-api",
    "deploy:services": "turbo run deploy --filter=\"@foodo/*-service\" --filter=\"@foodo/ai-*\"",
    "deploy:ai": "turbo run deploy --filter=\"@foodo/ai-*\"",
    "deploy:frontend": "node scripts/deploy-frontend-docker.js deploy",
    "deploy:frontend:diff": "node scripts/deploy-frontend-docker.js diff",
    "deploy:frontend:refresh": "node scripts/deploy-frontend-docker.js refresh",
    "deploy:frontend:local": "turbo run deploy --filter=web",
    "seed": "tsx scripts/seed-demo-data.ts",
    "deploy:all": "pnpm run deploy:infra && pnpm run deploy:core && pnpm run deploy:services && pnpm run seed && pnpm run deploy:frontend",
    "remove:frontend": "turbo run remove --filter=web",
    "remove:services": "turbo run remove --filter=\"@foodo/*-service\" --filter=\"@foodo/ai-*\"",
    "remove:ai": "turbo run remove --filter=\"@foodo/ai-*\"",
    "remove:core": "turbo run remove --filter=@foodo/core-api",
    "remove:infra": "turbo run remove --filter=@foodo/infra",
    "remove:all": "pnpm run remove:frontend && pnpm run remove:services && pnpm run remove:core && pnpm run remove:infra",
    "logs:payment": "cd backend/restaurant-service && serverless logs --function paymentConsumer --tail",
    "logs:reconcile": "cd backend/utils-service && serverless logs --function reconcile --tail",
    "logs:realtime": "cd backend/realtime-service && serverless logs --function eventConsumer --tail"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "prettier": "^3.6.2",
    "serverless": "catalog:",
    "serverless-esbuild": "catalog:",
    "serverless-prune-plugin": "catalog:",
    "serverless-python-requirements": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
