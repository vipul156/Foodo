{
  "name": "foodo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,json,md,yml,yaml}\"",

    "deploy:infra": "turbo run deploy --filter=@foodo/infra",
    "deploy:core": "turbo run deploy --filter=@foodo/core-api",
    "deploy:services": "turbo run deploy --filter='./backend/*'",
    "deploy:all": "pnpm run deploy:infra && pnpm run deploy:core && pnpm run deploy:services",

    "remove:services": "turbo run remove --filter='./backend/*'",
    "remove:core": "turbo run remove --filter=@foodo/core-api",
    "remove:infra": "turbo run remove --filter=@foodo/infra",
    "remove:all": "pnpm run remove:services && pnpm run remove:core && pnpm run remove:infra",

    "logs:payment": "cd backend/restaurant-service && serverless logs --function paymentConsumer --tail",
    "logs:reconcile": "cd backend/utils-service && serverless logs --function reconcile --tail",
    "logs:realtime": "cd backend/realtime-service && serverless logs --function eventConsumer --tail"
  },

  "devDependencies": {
    "prettier": "^3.6.2",
    "serverless": "catalog:",
    "serverless-esbuild": "catalog:",
    "serverless-prune-plugin": "catalog:",
    "esbuild": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
