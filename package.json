{
  "name": "foodo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,mts,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,json,md,yml,yaml}\"",

    "deploy:core": "cd infra/core && serverless deploy",
    "deploy:services": "cd infra/services && serverless deploy",
    "deploy": "pnpm run deploy:core && pnpm run deploy:services",

    "remove:services": "cd infra/services && serverless remove",
    "remove:core": "cd infra/core && serverless remove",
    "remove": "pnpm run remove:services && pnpm run remove:core",

    "logs:payment": "cd infra/services && serverless logs --function paymentConsumer --tail",
    "logs:reconcile": "cd infra/services && serverless logs --function reconcile --tail"
  },

  "devDependencies": {
    "prettier": "^3.6.2",
    "serverless": "catalog:",
    "serverless-esbuild": "catalog:",
    "serverless-prune-plugin": "catalog:",
    "esbuild": "catalog:",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
